{
  "schemaVersion": 1,
  "repository": "neurofoxpro/multimental",
  "name": "Multimental",
  "authorizedHosts": ["VENEL-SENDRIK"],
  "productionPackage": "pro.neurofox.multimental",
  "developmentPackage": "pro.neurofox.multimental.dev",
  "inputs": [
    "game/src", "game/tests", "game/project.godot", "game/export_presets.cfg",
    "tools", "scripts", "skills/game-production", ".gameprod/project.json",
    ".github/workflows", "package.json", ".nvmrc", "changes", ".prettierrc.json",
    "package-lock.json", ".gameprod/research.json", ".gameprod/requirements.json", "game/audio",
    ".gameprod/workplan.json", ".gameprod/play.json", ".gameprod/ideas", ".gameprod/collaboration.json"
  ],
  "generatedSuffixes": [".gd.uid", ".import"],
  "requiredFiles": [
    "AGENTS.md", "skills/game-production/SKILL.md", "docs/production/CHAT_RECOVERY.ru.md",
    ".gameprod/lifecycle.json", ".gameprod/backlog.json", "CHANGELOG.ru.md",
    "docs/MANUAL_TESTS.ru.md", "docs/production/CONTROL.ru.md", "docs/production/PLAY_RELEASE.ru.md"
  ],
  "steps": {
    "verify": {
      "command": ["node", "tools/verify.mjs"], "timeoutSeconds": 240,
      "markers": ["PRODUCTION_TESTS_PASS", "MULTIMENTAL_CORE_PASS", "MULTIMENTAL_UI_PASS", "MULTIMENTAL_PROTOCOL_PASS", "MULTIMENTAL_ROOM_PASS", "MULTIMENTAL_LAN_PASS", "MULTIMENTAL_BLUETOOTH_MODEL_PASS", "MULTIMENTAL_PRESENTATION_PASS", "MULTIMENTAL_DIRECTIONAL_PASS", "MULTIMENTAL_DIRECTIONAL_UI_PASS", "MULTIMENTAL_TERRAIN_PASS", "MULTIMENTAL_BALANCE_PARAMETERS_PASS", "MULTIMENTAL_ROOM_AUTOMATION_PASS", "MULTIMENTAL_PROFILE_PASS", "MULTIMENTAL_PROFILE_STORAGE_PASS", "MULTIMENTAL_PROFILE_UI_PASS", "MULTIMENTAL_COLLECTION_PASS", "MULTIMENTAL_COLLECTION_UI_PASS", "MULTIMENTAL_NETWORK_DECKS_PASS", "MULTIMENTAL_COLLECTION_LAB_PASS", "MULTIMENTAL_ECONOMY_PASS", "MULTIMENTAL_SHOP_UI_PASS"],
      "outputs": []
    },
    "build:android": {
      "command": ["node", "tools/project.mjs", "build", "android"], "timeoutSeconds": 600,
      "outputs": ["dist/multimental-debug.apk"], "requires": ["verified"]
    },
    "build:web": {
      "command": ["node", "tools/project.mjs", "build", "web"], "timeoutSeconds": 600,
      "outputs": ["dist/web/index.html"], "requires": ["verified"]
    }
  },
  "gates": {
    "verified": {"steps": ["verify"]},
    "android-built": {"steps": ["verify", "build:android"]},
    "web-built": {"steps": ["verify", "build:web"]},
    "manual-play": {"manual": true},
    "stable": {"manual": true}
  },
  "githubLogin": "venelsendrik",
  "deviceValidation": {
    "extraPhysicalChecks": ["bluetooth-player-room"],
    "selection": "hardware-sensitive PR paths require real-device tests; other cases default to emulators"
  }
}
